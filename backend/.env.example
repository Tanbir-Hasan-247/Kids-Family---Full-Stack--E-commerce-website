# ==========================================
# Kids & Family - Backend Production Environment Variables
# ==========================================

# 1. Django Security
# Generate a strong random key: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-a-very-strong-secret-key-in-production

# In production, set to False
DEBUG=False

# Comma-separated domain names / server IPs
# Example: yourdomain.com,api.yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com

# Timezone
TIME_ZONE=Asia/Dhaka

# 2. CORS & CSRF
# Specify your live frontend URLs
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# 3. Google Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Google OAuth (Optional Social Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Live URLs
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# 6. Database (Supabase PostgreSQL / PgBouncer Pooler)
# Note: For web servers, ALWAYS use Transaction Pooler port 6543 to avoid connection pool exhaustion
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 7. Cloudflare R2 Object Storage (Media / Product Images)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=kids-family-products
CLOUDFLARE_R2_ENDPOINT_URL=https://[ACCOUNT-ID].r2.cloudflarestorage.com
# Optional: R2.dev public domain or custom CDN domain (e.g. pub-xxxx.r2.dev or media.yourdomain.com)
CLOUDFLARE_R2_PUBLIC_URL=
