# ==========================================
# Kids & Family - Frontend Production Environment Variables
# ==========================================

# 1. Backend API Base URL
# If deployed on the same domain with Nginx reverse proxy, leave as /api
# If deployed on a separate domain (e.g. Vercel), set to https://api.yourdomain.com/api
VITE_API_URL=https://api.yourdomain.com/api

# 2. Backend Media URL (for uploaded product/variant images)
# If deployed on the same domain with Nginx, leave empty
# If deployed cross-domain (e.g. Vercel + Render), set to https://api.yourdomain.com
VITE_MEDIA_URL=https://api.yourdomain.com

